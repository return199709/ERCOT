# Copy to .env and fill in. Never commit .env.
# Placeholders only: do not put real or sample credentials in this file.

# Free api.data.gov key for the Regulations.gov API.
REGULATIONS_GOV_API_KEY=your-api-data-gov-key-here

# Databricks workspace access (CLI / SDK / SQL connector).
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-personal-access-token-here
DATABRICKS_SQL_WAREHOUSE_ID=your-warehouse-id-here

# Where the API reads gold data from: "snapshot" or "warehouse".
DATA_BACKEND=snapshot
SNAPSHOT_PATH=data/sample

# Comma-separated, hashed at rest by the service. Use long random values.
API_KEYS=your-demo-api-key-here
