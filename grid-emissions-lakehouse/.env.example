# Copy to .env and fill in. Never commit .env.
# Placeholders only: do not put real or sample credentials in this file.

# api.data.gov key used for the EPA CAMPD API (not needed for bulk files).
CAMPD_API_KEY=your-api-data-gov-key-here

# Free key from the EIA Open Data API.
EIA_API_KEY=your-eia-key-here

GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_PREFIX=your-bucket-prefix

# Authenticate with `gcloud auth application-default login` locally and a
# service account in CI. Do not commit service account key files.
