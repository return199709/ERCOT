# Copy to .env and fill in. Never commit .env.
# Placeholders only: do not put real or sample credentials in this file.

# SEC EDGAR asks for a descriptive User-Agent with a contact address.
EDGAR_USER_AGENT="your-name your-email@example.com"

AZURE_STORAGE_ACCOUNT=your-storage-account-name
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX=filings-chunks
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment
AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment

# Prefer managed identity / `az login` (DefaultAzureCredential) over keys.
# Only set these for local development if you cannot use identity auth.
AZURE_SEARCH_API_KEY=
AZURE_OPENAI_API_KEY=
