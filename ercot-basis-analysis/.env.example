# Credentials for the ERCOT Public API, read by gridstatus.ErcotAPI.
# Copy this file to .env and fill in the values. Never commit .env.
#
# Register for an account:     https://apiexplorer.ercot.com/
# Obtain a subscription key:   https://developer.ercot.com/applications/pubapi/

ERCOT_API_USERNAME=
ERCOT_API_PASSWORD=
ERCOT_PUBLIC_API_SUBSCRIPTION_KEY=

# Optional: only needed for Energy Storage Resource (ESR) endpoints.
ERCOT_ESR_API_SUBSCRIPTION_KEY=
